{
  "manifest_version": 3,
  "name": "ORGMode-plugin",
  "version": "1.1",
  "description": "Captures current tab information and selected text",
  "browser_specific_settings": {
    "gecko": {
      "id": "my-extension@example.com"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "ORGMode Plugin"
  }
}
